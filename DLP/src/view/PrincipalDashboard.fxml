<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.PrincipalDashboardController"
            styleClass="main-container">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <Label text="Digital Lesson Planner" styleClass="header-title"/>
            <Label text="Curriculum Progress Dashboard" styleClass="header-subtitle"/>
            <Label fx:id="principalNameLabel" text="Welcome, Principal" HBox.hgrow="ALWAYS" styleClass="header-user"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            
            <Label text="PRINCIPAL MENU" styleClass="sidebar-title"/>
            
            <Button text="Dashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="sidebar-button-active"/>
            <Button text="Teachers" maxWidth="Infinity" onAction="#showTeachers" styleClass="sidebar-button"/>
            <Button text="Calendar" maxWidth="Infinity" onAction="#showCalendar" styleClass="sidebar-button"/>
            <Button text="Reports" maxWidth="Infinity" onAction="#showReports" styleClass="sidebar-button"/>
            
            <VBox VBox.vgrow="ALWAYS"/>
            
            <Button text="Refresh" maxWidth="Infinity" onAction="#refreshDashboard" styleClass="refresh-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- KPI Summary Cards -->
            <HBox spacing="15">
                <VBox spacing="8" prefWidth="200" prefHeight="100" alignment="CENTER" styleClass="kpi-card">
                    <Label text="Total Teachers" styleClass="kpi-label"/>
                    <Label fx:id="totalTeachersLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                
                <VBox spacing="8" prefWidth="200" prefHeight="100" alignment="CENTER" styleClass="kpi-card">
                    <Label text="Average Progress" styleClass="kpi-label"/>
                    <Label fx:id="averageProgressLabel" text="0%" styleClass="kpi-value"/>
                </VBox>
                
                <VBox spacing="8" prefWidth="200" prefHeight="100" alignment="CENTER" styleClass="kpi-card-success">
                    <Label text="On Track" styleClass="kpi-label"/>
                    <Label fx:id="onTrackLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                
                <VBox spacing="8" prefWidth="200" prefHeight="100" alignment="CENTER" styleClass="kpi-card-warning">
                    <Label text="Need Support" styleClass="kpi-label"/>
                    <Label fx:id="needSupportLabel" text="0" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <!-- Overall Status Section -->
            <HBox spacing="20">
                <VBox spacing="15" prefWidth="400" styleClass="card">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <Label text="Overall Status" styleClass="section-title"/>
                    <HBox spacing="20" alignment="CENTER">
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="On Track" styleClass="status-label-green"/>
                            <Label fx:id="onTrackPercentLabel" text="0%" styleClass="status-value"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="At Risk" styleClass="status-label-amber"/>
                            <Label fx:id="atRiskPercentLabel" text="0%" styleClass="status-value"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="Behind" styleClass="status-label-red"/>
                            <Label fx:id="behindPercentLabel" text="0%" styleClass="status-value"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox spacing="15" prefWidth="400" styleClass="card">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <Label text="Subject Area Progress" styleClass="section-title"/>
                    <HBox spacing="15" alignment="CENTER">
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="Mathematics" styleClass="subject-label"/>
                            <Label fx:id="mathProgressLabel" text="0%" styleClass="subject-value"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="Sciences" styleClass="subject-label"/>
                            <Label fx:id="scienceProgressLabel" text="0%" styleClass="subject-value"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER">
                            <Label text="Languages" styleClass="subject-label"/>
                            <Label fx:id="languageProgressLabel" text="0%" styleClass="subject-value"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Teacher Progress Overview -->
            <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Teacher Progress Overview" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Export Report" onAction="#handleExportReport" styleClass="export-button"/>
                </HBox>
                
                <TableView fx:id="teacherProgressTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="teacherNameColumn" text="Teacher Name" prefWidth="200"/>
                        <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="150"/>
                        <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="100"/>
                        <TableColumn fx:id="progressColumn" text="Progress" prefWidth="150"/>
                        <TableColumn fx:id="lessonCountColumn" text="Lessons" prefWidth="100"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>