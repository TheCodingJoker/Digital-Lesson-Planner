<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.PrincipalDashboardController"
            styleClass="dashboard-root, principal-dashboard"
            stylesheets="@styles/dlp-theme.css">

    <top>
        <HBox styleClass="app-header, principal-app-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="8" right="28" bottom="8" left="28"/>
            </padding>

            <Label text="&#9638;" styleClass="app-header-icon"/>
            <VBox spacing="1">
                <Label text="Digital Lesson Planner" styleClass="app-header-title"/>
                <Label text="Principal Portal" styleClass="app-header-subtitle"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button fx:id="navDashboardButton" text="Dashboard" onAction="#showDashboard"
                    styleClass="principal-nav-button" maxWidth="Infinity"/>
            <Button fx:id="navCalendarButton" text="Calendar" onAction="#showCalendar"
                    styleClass="principal-nav-button" maxWidth="Infinity"/>
            <Button fx:id="navReportsButton" text="Reports" onAction="#showReports"
                    styleClass="principal-nav-button" maxWidth="Infinity"/>

            <VBox spacing="0" alignment="CENTER_RIGHT">
                <Label fx:id="userNameLabel" styleClass="app-header-username"/>
                <Label text="Principal" styleClass="app-header-userrole"/>
            </VBox>
            <Button fx:id="logoutButton" text="&#10132;" onAction="#handleLogout" styleClass="logout-icon-button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="dashboard-content">
            <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" styleClass="principal-scroll-pane">
                <content>
                    <VBox spacing="18" styleClass="principal-content">
                        <padding>
                            <Insets top="18" right="28" bottom="24" left="28"/>
                        </padding>

                        <VBox spacing="5" styleClass="principal-hero">
                            <Label text="Curriculum Progress Dashboard" styleClass="principal-hero-title"/>
                            <Label text="School-wide curriculum coverage monitoring" styleClass="principal-hero-subtitle"/>
                        </VBox>

                        <FlowPane fx:id="principalKpiContainer" hgap="14" vgap="14"
                                  styleClass="principal-kpi-row">
                            <VBox spacing="8" prefHeight="112" maxWidth="Infinity" alignment="CENTER_LEFT"
                                  styleClass="principal-kpi-card">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="&#9786;" styleClass="principal-kpi-icon, principal-kpi-icon-blue"/>
                                    <Label text="Total Teachers" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="totalTeachersLabel" text="0" styleClass="kpi-value"/>
                                <Label text="Active teacher accounts" styleClass="kpi-caption"/>
                            </VBox>
                            <VBox spacing="8" prefHeight="112" maxWidth="Infinity" alignment="CENTER_LEFT"
                                  styleClass="principal-kpi-card">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="&#8599;" styleClass="principal-kpi-icon, principal-kpi-icon-green"/>
                                    <Label text="Avg. Progress" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="averageProgressLabel" text="0%" styleClass="kpi-value"/>
                                <Label text="Across teachers with lesson plans" styleClass="kpi-caption"/>
                            </VBox>
                            <VBox spacing="8" prefHeight="112" maxWidth="Infinity" alignment="CENTER_LEFT"
                                  styleClass="principal-kpi-card, principal-kpi-success">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="&#10003;" styleClass="principal-kpi-icon, principal-kpi-icon-green"/>
                                    <Label text="On Track" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="onTrackLabel" text="0" styleClass="kpi-value"/>
                                <Label text="At least 70% complete" styleClass="kpi-caption"/>
                            </VBox>
                            <VBox spacing="8" prefHeight="112" maxWidth="Infinity" alignment="CENTER_LEFT"
                                  styleClass="principal-kpi-card, principal-kpi-warning">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="!" styleClass="principal-kpi-icon, principal-kpi-icon-orange"/>
                                    <Label text="Need Support" styleClass="kpi-label"/>
                                </HBox>
                                <Label fx:id="needSupportLabel" text="0" styleClass="kpi-value"/>
                                <Label text="Below 50% or no lesson plans" styleClass="kpi-caption"/>
                            </VBox>
                        </FlowPane>

                        <HBox spacing="16" styleClass="principal-chart-row">
                            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="principal-panel, principal-subject-panel">
                                <padding>
                                    <Insets top="16" right="18" bottom="14" left="18"/>
                                </padding>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Subject Area Progress" styleClass="section-label"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Button text="Export Report" onAction="#handleExportReport"
                                            styleClass="principal-export-button"/>
                                </HBox>
                                <BarChart fx:id="subjectProgressChart" animated="false"
                                          legendVisible="false" title="" styleClass="principal-bar-chart"
                                          prefHeight="250" minHeight="210">
                                    <xAxis>
                                        <CategoryAxis fx:id="subjectAxis" side="BOTTOM"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="subjectProgressAxis" side="LEFT"
                                                    lowerBound="0" upperBound="100" tickUnit="25"
                                                    autoRanging="false"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>
                            <VBox spacing="10" prefWidth="390" minWidth="330"
                                  styleClass="principal-panel, principal-status-panel">
                                <padding>
                                    <Insets top="16" right="18" bottom="14" left="18"/>
                                </padding>
                                <Label text="Overall Status" styleClass="section-label"/>
                                <HBox spacing="12" alignment="CENTER">
                                    <StackPane prefWidth="180" prefHeight="180" minWidth="160" minHeight="160">
                                        <PieChart fx:id="completionBandPieChart" legendVisible="false"
                                                  labelsVisible="false" animated="false"
                                                  prefWidth="180" prefHeight="180"/>
                                        <Circle radius="46" styleClass="principal-donut-hole"/>
                                        <VBox alignment="CENTER" mouseTransparent="true">
                                            <Label fx:id="completionBandTotalLabel" text="0"
                                                   styleClass="principal-donut-total"/>
                                            <Label text="TEACHERS" styleClass="principal-donut-caption"/>
                                        </VBox>
                                        <Label fx:id="completionBandEmptyLabel"
                                               text="No lesson plan data"
                                               styleClass="kpi-caption" visible="false" managed="false"/>
                                    </StackPane>
                                    <VBox spacing="10" alignment="CENTER_LEFT" styleClass="principal-chart-legend">
                                        <HBox spacing="6" alignment="CENTER_LEFT">
                                            <Circle radius="4" styleClass="principal-legend-dot-green"/>
                                            <Label fx:id="highCompletionLegendLabel" text="On Track: 0 (0%)"/>
                                        </HBox>
                                        <HBox spacing="6" alignment="CENTER_LEFT">
                                            <Circle radius="4" styleClass="principal-legend-dot-amber"/>
                                            <Label fx:id="moderateCompletionLegendLabel" text="At Risk: 0 (0%)"/>
                                        </HBox>
                                        <HBox spacing="6" alignment="CENTER_LEFT">
                                            <Circle radius="4" styleClass="principal-legend-dot-red"/>
                                            <Label fx:id="lowCompletionLegendLabel" text="Behind: 0 (0%)"/>
                                        </HBox>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>

                        <VBox spacing="0" styleClass="principal-panel, principal-teacher-panel">
                            <padding>
                                <Insets top="14" right="0" bottom="0" left="0"/>
                            </padding>
                            <Label text="Teacher Progress Overview" styleClass="section-label"
                                   style="-fx-padding: 0 16 12 16;"/>
                            <TableView fx:id="teacherProgressTable" VBox.vgrow="ALWAYS"
                                       prefHeight="270" minHeight="220"
                                       styleClass="data-table, principal-teacher-table">
                                <columns>
                                    <TableColumn fx:id="teacherNameColumn" text="TEACHER" prefWidth="220"/>
                                    <TableColumn fx:id="subjectColumn" text="SUBJECT" prefWidth="180"/>
                                    <TableColumn fx:id="gradeColumn" text="GRADE" prefWidth="110"/>
                                    <TableColumn fx:id="progressColumn" text="PROGRESS" prefWidth="190"/>
                                    <TableColumn fx:id="lessonsColumn" text="LESSONS" prefWidth="120"/>
                                    <TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="150"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>