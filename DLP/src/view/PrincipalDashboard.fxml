<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.PrincipalDashboardController">

   

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-background-color: #1f2937; -fx-padding: 18;">

            <Label text="DIGITAL LESSON PLANNER"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Label text="Principal Dashboard"
                   style="-fx-text-fill: #d1d5db;
                          -fx-font-size: 16px;"/>

            <Label fx:id="principalNameLabel"
                   text="Welcome, Principal"
                   HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: white;
                          -fx-font-size: 15px;"/>

            <Button text="Logout"
                    onAction="#logout"
                    style="-fx-background-color: #dc2626;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

        </HBox>

    </top>



    <left>

        <VBox spacing="10"
              prefWidth="220"
              style="-fx-background-color: #111827;
                     -fx-padding: 20;">

            <Label text="PRINCIPAL MENU"
                   style="-fx-text-fill: white;
                          -fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 15 0;"/>


            <Button text="Dashboard"
                    maxWidth="Infinity"
                    onAction="#showDashboard"
                    style="-fx-background-color: #374151;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 12;"/>


            <Button text="Lesson Plans"
                    maxWidth="Infinity"
                    onAction="#showLessonPlans"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 12;"/>


            <Button text="Students"
                    maxWidth="Infinity"
                    onAction="#showStudents"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 12;"/>


            <Button text="Teachers"
                    maxWidth="Infinity"
                    onAction="#showTeachers"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 12;"/>


            <Button text="Reports"
                    maxWidth="Infinity"
                    onAction="#showReports"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 12;"/>


            <VBox VBox.vgrow="ALWAYS"/>


            <Button text="Refresh Dashboard"
                    maxWidth="Infinity"
                    onAction="#refreshDashboard"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 12;"/>

        </VBox>

    </left>




    <center>

        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #f3f4f6;">

            <VBox spacing="20"
                  alignment="TOP_LEFT">

                <padding>
                    <Insets top="30"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>



                <Label text="Principal Overview"
                       style="-fx-font-size: 28px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;"/>


                <Label text="Monitor lesson planning and school activities."
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #6b7280;"/>



                <HBox spacing="20">


                

                    <VBox spacing="10"
                          prefWidth="190"
                          prefHeight="120"
                          alignment="CENTER"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">

                        <Label text="Total Lessons"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #6b7280;"/>

                        <Label fx:id="totalLessonsLabel"
                               text="0"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #111827;"/>

                    </VBox>


            

                    <VBox spacing="10"
                          prefWidth="190"
                          prefHeight="120"
                          alignment="CENTER"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">

                        <Label text="Pending"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #6b7280;"/>

                        <Label fx:id="pendingLessonsLabel"
                               text="0"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #d97706;"/>

                    </VBox>


                    <!-- APPROVED -->

                    <VBox spacing="10"
                          prefWidth="190"
                          prefHeight="120"
                          alignment="CENTER"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">

                        <Label text="Approved"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #6b7280;"/>

                        <Label fx:id="approvedLessonsLabel"
                               text="0"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #16a34a;"/>

                    </VBox>



                    <VBox spacing="10"
                          prefWidth="190"
                          prefHeight="120"
                          alignment="CENTER"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">

                        <Label text="Rejected"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #6b7280;"/>

                        <Label fx:id="rejectedLessonsLabel"
                               text="0"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #dc2626;"/>

                    </VBox>

                </HBox>


               
                <VBox spacing="10"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-padding: 25;">

                    <Label text="Principal Responsibilities"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;"/>

                    <Label text="• Review and approve lesson plans"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #374151;"/>

                    <Label text="• Monitor teachers"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #374151;"/>

                    <Label text="• Manage student information"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #374151;"/>

                    <Label text="• View school reports"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #374151;"/>

                </VBox>

            </VBox>

        </StackPane>

    </center>

</BorderPane>
