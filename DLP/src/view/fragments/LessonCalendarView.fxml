<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LessonCalendarController"
      spacing="18" prefWidth="760">

    <HBox alignment="CENTER" spacing="16">
        <Button fx:id="prevButton" text="&#10094;" onAction="#handlePrevMonth" styleClass="calendar-nav-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="monthYearLabel" styleClass="calendar-month-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="nextButton" text="&#10095;" onAction="#handleNextMonth" styleClass="calendar-nav-button"/>
    </HBox>

    <GridPane fx:id="calendarGrid" hgap="8" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.32"/>
        </columnConstraints>
    </GridPane>

</VBox>
