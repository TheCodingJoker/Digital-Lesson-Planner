<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ClassesController"
      spacing="18" styleClass="dashboard-content">
    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <VBox styleClass="content-card" spacing="14" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="My Classes" styleClass="section-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New Class" onAction="#handleNewClass" styleClass="primary-button"/>
        </HBox>

        <TableView fx:id="classesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="classNameColumn" text="Class" prefWidth="160"/>
                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="180"/>
                <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="100"/>
                <TableColumn fx:id="studentCountColumn" text="Students" prefWidth="90"/>
                <TableColumn fx:id="notesColumn" text="Notes" prefWidth="180"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
