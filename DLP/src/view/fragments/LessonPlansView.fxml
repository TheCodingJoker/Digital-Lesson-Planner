<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LessonPlansController"
      spacing="18" styleClass="dashboard-content">
    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <VBox styleClass="content-card" spacing="14" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="My Lesson Plans" styleClass="section-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Status:" styleClass="field-label"/>
            <ComboBox fx:id="filterStatusCombo"/>
            <Button text="+  Create Lesson Plan" onAction="#handleNewLessonPlan" styleClass="primary-button"/>
        </HBox>

        <TableView fx:id="lessonPlansTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titleColumn" text="Topic" prefWidth="180"/>
                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="150"/>
                <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="80"/>
                <TableColumn fx:id="termColumn" text="Term" prefWidth="80"/>
                <TableColumn fx:id="dateColumn" text="Lesson Date" prefWidth="110"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="340"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
