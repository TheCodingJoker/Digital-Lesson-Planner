<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController"
            styleClass="dashboard-root"
            stylesheets="@styles/dlp-theme.css">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <Label text="⚙" styleClass="app-header-icon"/>
            <VBox spacing="1">
                <Label text="System Administration" styleClass="app-header-title"/>
                <Label text="Manage users, curriculum data, and system settings" styleClass="app-header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="0" alignment="CENTER_RIGHT">
                <Label fx:id="userNameLabel" styleClass="app-header-username"/>
                <Label text="Administrator" styleClass="app-header-userrole"/>
            </VBox>
            <Button fx:id="feedbackButton" text="💬" onAction="#handleFeedback" styleClass="icon-button"/>
            <Button fx:id="logoutButton" text="→" onAction="#handleLogout" styleClass="logout-icon-button"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="adminTabPane" styleClass="admin-tab-pane" tabClosingPolicy="UNAVAILABLE">
            
            <!-- User Management Tab -->
            <Tab text="User Management" styleClass="admin-tab">
                <VBox spacing="16" styleClass="tab-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="User Accounts" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Add User" onAction="#handleAddUser" styleClass="primary-button"/>
                    </HBox>
                    
                    <TableView fx:id="usersTable" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- CAPS Database Tab -->
            <Tab text="CAPS Database" styleClass="admin-tab">
                <VBox spacing="16" styleClass="tab-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="CAPS Curriculum Entries" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Add Entry" onAction="#handleAddCAPSEntry" styleClass="primary-button"/>
                    </HBox>
                    
                    <TableView fx:id="capsTable" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="capsCodeColumn" text="CAPS Code" prefWidth="150"/>
                            <TableColumn fx:id="capsSubjectColumn" text="Subject" prefWidth="120"/>
                            <TableColumn fx:id="capsGradeColumn" text="Grade" prefWidth="100"/>
                            <TableColumn fx:id="capsTermColumn" text="Term" prefWidth="80"/>
                            <TableColumn fx:id="capsTopicColumn" text="Topic" prefWidth="200"/>
                            <TableColumn fx:id="capsActionsColumn" text="Actions" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- School Calendar Tab -->
            <Tab text="School Calendar" styleClass="admin-tab">
                <VBox spacing="16" styleClass="tab-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="School Events" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Add Event" onAction="#handleAddEvent" styleClass="primary-button"/>
                    </HBox>
                    
                    <TableView fx:id="eventsTable" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="eventNameColumn" text="Event Name" prefWidth="200"/>
                            <TableColumn fx:id="eventDateColumn" text="Date" prefWidth="120"/>
                            <TableColumn fx:id="eventTypeColumn" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="eventActionsColumn" text="Actions" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Audit Log Tab -->
            <Tab text="Audit Log" styleClass="admin-tab">
                <VBox spacing="16" styleClass="tab-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="System Audit Log" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Export Log" onAction="#handleExportLog" styleClass="secondary-button"/>
                    </HBox>

                    <TableView fx:id="auditLogTable" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="auditActionColumn" text="Action" prefWidth="200"/>
                            <TableColumn fx:id="auditTargetColumn" text="Target" prefWidth="150"/>
                            <TableColumn fx:id="auditTimestampColumn" text="Timestamp" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Feedback Tab -->
            <Tab text="Feedback" styleClass="admin-tab">
                <VBox spacing="16" styleClass="tab-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="User Feedback" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <TableView fx:id="feedbackTable" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="feedbackTitleColumn" text="Title" prefWidth="200"/>
                            <TableColumn fx:id="feedbackTypeColumn" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="feedbackPriorityColumn" text="Priority" prefWidth="100"/>
                            <TableColumn fx:id="feedbackStatusColumn" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="feedbackDateColumn" text="Submitted" prefWidth="150"/>
                            <TableColumn fx:id="feedbackActionsColumn" text="Actions" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>