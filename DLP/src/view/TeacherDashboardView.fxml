<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.TeacherDashboardController"
            styleClass="dashboard-root, teacher-dashboard"
            stylesheets="@styles/dlp-theme.css">

    <top>
        <HBox styleClass="app-header, teacher-app-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="8" right="28" bottom="8" left="28"/>
            </padding>

            <Label text="&#128214;" styleClass="app-header-icon"/>
            <VBox spacing="1">
                <Label text="Digital Lesson Planner" styleClass="app-header-title"/>
                <Label text="Teacher Portal" styleClass="app-header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="navDashboardButton" text="Dashboard" onAction="#handleNavDashboard"
                    styleClass="teacher-nav-button"/>
            <Button fx:id="navCalendarButton" text="Calendar" onAction="#handleNavCalendar"
                    styleClass="teacher-nav-button"/>
            <Button fx:id="navLessonPlansButton" text="Lesson Plans" onAction="#handleNavLessonPlans"
                    styleClass="teacher-nav-button"/>

            <VBox spacing="0" alignment="CENTER_RIGHT">
                <Label fx:id="userNameLabel" styleClass="app-header-username"/>
                <Label text="Teacher" styleClass="app-header-userrole"/>
            </VBox>
            <StackPane>
                <Button fx:id="notificationButton" text="&#128276;" onAction="#handleNotifications"
                        styleClass="header-icon-button" accessibleText="Notifications"/>
                <Label fx:id="notificationBadge" text="0" visible="false" managed="false"
                       mouseTransparent="true" styleClass="notification-badge"/>
            </StackPane>
            <Button fx:id="feedbackButton" text="&#128172;" onAction="#handleFeedback" styleClass="icon-button"/>
            <Button fx:id="logoutButton" text="&#10132;" onAction="#handleLogout" styleClass="logout-icon-button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="dashboard-content"/>
    </center>

</BorderPane>
